    box.appendChild(btn);
  });
}

function choose(choice) {
  if (answered) return;
  answered = true;

  const item = activeQuestions[index];
  const isCorrect = choice === item.answer;
  if (isCorrect) score++;

  answers.push({
    question: item,
    choice,
    correct: isCorrect
  });

  [...$("options").children].forEach((btn, i) => {
    btn.disabled = true;
    if (i === item.answer) btn.classList.add("correct");
    if (i === choice && i !== item.answer) btn.classList.add("wrong");
  });

  $("scoreText").textContent = `目前答對：${score}`;
  $("statusText").textContent = isCorrect ? "✓ 答對" : "✕ 答錯";
  $("explanation").innerHTML = `<strong>${isCorrect ? "答對了" : "正確答案：" + letters[item.answer] + "．" + item.options[item.answer]}</strong>${item.explanation}`;
  $("explanation").classList.remove("hidden");
  $("nextBtn").disabled = false;
}

function nextQuestion() {
  if (!answered) return;
  if (index < activeQuestions.length - 1) {
    index++;
    renderQuestion();
  } else {
    finishQuiz();
  }
}

function finishQuiz() {
  $("quiz").classList.add("hidden");
  $("result").classList.remove("hidden");

  const total = activeQuestions.length;
  const pct = Math.round((score / total) * 100);
  const wrong = total - score;

  $("finalPercent").textContent = `${pct}%`;
  $("correctCount").textContent = score;
  $("wrongCount").textContent = wrong;
  $("totalCount").textContent = total;

  let message = "建議先看錯題詳解，再重刷一次。";
  if (pct >= 90) message = "掌握度很高，可以再用隨機模式確認穩定度。";
  else if (pct >= 75) message = "基礎已經不錯，優先補強錯題與容易混淆的數字。";
  else if (pct >= 60) message = "有基本概念，但還有幾組常考數字需要再記熟。";
  $("finalMessage").textContent = message;

  const wrongAnswers = answers.filter(a => !a.correct);
  localStorage.setItem("nhiWrongQuestions2026", JSON.stringify(wrongAnswers.map(a => QUESTION_BANK.indexOf(a.question))));

  $("retryWrongBtn").disabled = wrongAnswers.length === 0;
  $("retryWrongBtn").textContent = wrongAnswers.length ? `錯題重練（${wrongAnswers.length}題）` : "本回全對";

  const review = $("review");
  review.innerHTML = wrongAnswers.length ? "<h2>錯題詳解</h2>" : "<h2>這一回沒有錯題</h2>";

  wrongAnswers.forEach((a, i) => {
    const item = a.question;
    const div = document.createElement("div");
    div.className = "review-item";
    div.innerHTML = `
      <h3>${i + 1}. ${item.q}</h3>
      <div class="mine">你的答案：${letters[a.choice]}．${item.options[a.choice]}</div>
      <div class="right">正確答案：${letters[item.answer]}．${item.options[item.answer]}</div>
      <div style="margin-top:7px">${item.explanation}</div>
    `;
    review.appendChild(div);
  });

  window.scrollTo({top:0, behavior:"smooth"});
}

function restart() {
  $("result").classList.add("hidden");
  $("quiz").classList.add("hidden");
  $("setup").classList.remove("hidden");
  window.scrollTo({top:0, behavior:"smooth"});
}

$("startBtn").addEventListener("click", () => startQuiz());
$("nextBtn").addEventListener("click", nextQuestion);
$("quitBtn").addEventListener("click", finishQuiz);
$("restartBtn").addEventListener("click", restart);
$("retryWrongBtn").addEventListener("click", () => {
  const wrongQuestions = answers.filter(a => !a.correct).map(a => a.question);
  if (wrongQuestions.length) startQuiz(wrongQuestions);
});

document.addEventListener("keydown", (e) => {
  if ($("quiz").classList.contains("hidden")) return;
  if (!answered && ["1","2","3","4"].includes(e.key)) {
    choose(Number(e.key) - 1);
  } else if (answered && e.key === "Enter") {
    nextQuestion();
  }
});
</script>
</body>
</html>
